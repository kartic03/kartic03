# Review artifacts: regenerated by every build, and page.html alone is ~680 KB.
# Committing them would bloat history for files nothing depends on.
dist/_sheet/
dist/page.html
dist/page-preview.png
dist/page-dark.svg
dist/page-light.svg
dist/_posed_tmp.svg

# The panel SVGs in dist/ ARE committed: the README points at them, and the
# profile renders straight from the repo.

__pycache__/
*.pyc
.DS_Store
Thumbs.db
